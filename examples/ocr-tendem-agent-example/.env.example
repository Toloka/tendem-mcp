# Any OpenAI-compatible endpoint. One model does everything, so it needs
# vision *and* tool calling.
# OpenAI:  https://api.openai.com/v1              + gpt-4o-mini
# Nebius:  https://api.studio.nebius.com/v1       + Qwen/Qwen2.5-VL-72B-Instruct
# vLLM:    http://localhost:8000/v1               + whatever you serve
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OCR_MODEL=gpt-4o-mini

# Human experts: agent.tendem.ai/mcp → "Agent builders" tab.
TENDEM_API_KEY=

# Which Tendem deployment to talk to. Leave unset for production; set it to
# the prestable MCP endpoint to test against that instead.
# TENDEM_MCP_URL=

# Spend cap per escalated document, USD. Quotes under it are approved
# automatically; quotes over it are reported and nothing is charged.
TENDEM_MAX_PRICE=10

# Below this a human reads it, and a model-only row is written as
# 'unresolved' rather than trusted. Clean scans self-report ~0.99.
OCR_MIN_CONFIDENCE=0.95
